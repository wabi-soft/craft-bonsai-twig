{% import "_includes/forms" as forms %}

{% set configWarning = "Overridden by config/bonsai-twig.php — changes saved here won't take effect."|t('bonsai-twig') %}

{{ forms.radioGroupField({
    label: "Template Resolution Strategy"|t('bonsai-twig'),
    instructions: "<strong>Section-first</strong> uses section as the primary folder (default). <strong>Type-first</strong> uses entry type as the primary folder, aligning with Craft 5's standalone entry types. Can also be set per-template call."|t('bonsai-twig'),
    id: 'strategy',
    name: 'strategy',
    value: settings.strategy,
    disabled: 'strategy' in overrides,
    warning: 'strategy' in overrides ? configWarning : null,
    options: [
        { label: 'Section-first (default)'|t('bonsai-twig'), value: 'section' },
        { label: 'Type-first (Craft 5)'|t('bonsai-twig'), value: 'type' },
    ],
}) }}

{% set llmOverrideWarning = llmEnv is not null
    ? "Overridden by the BONSAI_LLM_MODE environment variable (currently {state}) — this toggle has no effect."|t('bonsai-twig', { state: llmEnv ? 'on' : 'off' })
    : ('llmMode' in overrides ? configWarning : null) %}
{% set devWarning = not devMode ? "Dev mode is off, so trace comments won't emit regardless of this setting."|t('bonsai-twig') : null %}

{{ forms.lightswitchField({
    label: "LLM Trace Comments"|t('bonsai-twig'),
    instructions: "Wraps Bonsai-resolved output in <code>&lt;!-- bonsai:start … --&gt;</code> comments so AI agents reading page source can map DOM back to templates. Dev-only — never emits in production."|t('bonsai-twig'),
    id: 'llmMode',
    name: 'llmMode',
    on: llmEnv ?? settings.llmMode,
    disabled: llmOverrideWarning is not null,
    warning: [llmOverrideWarning, devWarning]|filter(w => w)|join(' ') ?: null,
}) }}


<hr>

<details style="margin-top: 12px;">
    <summary style="cursor: pointer; color: #0d78f2;">{{ "Show example configuration"|t('bonsai-twig') }}</summary>
    <pre style="background:#f5f5f5; padding:8px; border-radius:4px; font-size: 10px; margin-top: 8px;">// config/bonsai-twig.php — overrides settings saved on this page
return [
    'strategy' => 'section',
    'paths' => [
        'entry' => '_entry',
        'item' => '_item',
        'category' => '_category',
        'matrix' => '_matrix',
        'asset' => '_asset',
        'product' => '_product',
    ],
    // env BONSAI_LLM_MODE beats both this file and the CP toggle
    'llmMode' => true,
];</pre>
</details>